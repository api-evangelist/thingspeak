{
  "opencollection": "1.0.0",
  "info": {
    "name": "ThingSpeak Channels API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "THINGSPEAKAPIKEY",
      "value": "{{THINGSPEAKAPIKEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "List User Channels",
        "type": "http"
      },
      "http": {
        "method": "GET",
        "url": "https://api.thingspeak.com/channels.json"
      },
      "docs": "List User Channels"
    },
    {
      "info": {
        "name": "Create Channel",
        "type": "http"
      },
      "http": {
        "method": "POST",
        "url": "https://api.thingspeak.com/channels.json",
        "body": {
          "type": "json",
          "data": "{}"
        }
      },
      "docs": "Create Channel"
    },
    {
      "info": {
        "name": "List Public Channels",
        "type": "http"
      },
      "http": {
        "method": "GET",
        "url": "https://api.thingspeak.com/channels/public.json",
        "params": [
          {
            "name": "tag",
            "value": "",
            "type": "query"
          },
          {
            "name": "username",
            "value": "",
            "type": "query"
          },
          {
            "name": "page",
            "value": "",
            "type": "query"
          }
        ]
      },
      "docs": "List Public Channels"
    },
    {
      "info": {
        "name": "Read Channel Settings",
        "type": "http"
      },
      "http": {
        "method": "GET",
        "url": "https://api.thingspeak.com/channels/:channel_id.json",
        "params": [
          {
            "name": "channel_id",
            "value": "",
            "type": "path"
          }
        ]
      },
      "docs": "Read Channel Settings"
    },
    {
      "info": {
        "name": "Update Channel Settings",
        "type": "http"
      },
      "http": {
        "method": "PUT",
        "url": "https://api.thingspeak.com/channels/:channel_id.json",
        "params": [
          {
            "name": "channel_id",
            "value": "",
            "type": "path"
          }
        ],
        "body": {
          "type": "json",
          "data": "{}"
        }
      },
      "docs": "Update Channel Settings"
    },
    {
      "info": {
        "name": "Delete Channel",
        "type": "http"
      },
      "http": {
        "method": "DELETE",
        "url": "https://api.thingspeak.com/channels/:channel_id.json",
        "params": [
          {
            "name": "channel_id",
            "value": "",
            "type": "path"
          }
        ]
      },
      "docs": "Delete Channel"
    },
    {
      "info": {
        "name": "Clear Channel Feed",
        "type": "http"
      },
      "http": {
        "method": "DELETE",
        "url": "https://api.thingspeak.com/channels/:channel_id/feeds.json",
        "params": [
          {
            "name": "channel_id",
            "value": "",
            "type": "path"
          }
        ]
      },
      "docs": "Clear Channel Feed"
    }
  ],
  "bundled": true
}